<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Converter"
        tools:targetApi="31">

        <activity android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"/>

        <activity
            android:name=".SplashScreen"
            android:exported="true"
            android:theme="@style/splashscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".temp_cal"     android:exported="false"/>
        <activity android:name=".weight_cal"   android:exported="false"/>
        <activity android:name=".length_cal"   android:exported="false"/>
        <activity android:name=".speed_cal"    android:exported="false"/>
        <activity android:name=".freq_cal"     android:exported="false"/>
        <activity android:name=".currency_cal" android:exported="false"/>
        <activity android:name=".volume_cal"   android:exported="false"/>
        <activity android:name=".time_cal"     android:exported="false"/>
        <activity android:name=".area_cal"     android:exported="false"/>
        <activity android:name=".fuel_cal"     android:exported="false"/>

    </application>

</manifest>
