<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/space_black"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="64dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONVERTER"
                android:textColor="@color/space_text_primary"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.18"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Precision in every unit"
                android:textColor="@color/space_text_secondary"
                android:textSize="13sp"
                android:letterSpacing="0.04"
                android:fontFamily="sans-serif"/>

        </LinearLayout>

        <!-- Row 1 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center"
            android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingBottom="10dp"
            android:weightSum="3">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:padding="5dp">
                <androidx.cardview.widget.CardView android:id="@+id/cv_tmp"
                    android:layout_width="match_parent" android:layout_height="140dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="22dp" app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/space_surface">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp"
                        android:background="@drawable/bg_card_glass">
                        <LinearLayout android:layout_width="56dp" android:layout_height="56dp"
                            android:background="@drawable/ic_bg_temperature" android:gravity="center">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                android:src="@drawable/temperature" app:tint="@color/card_temperature"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" android:text="TEMPERATURE"
                            android:textColor="@color/space_text_primary" android:textSize="10sp"
                            android:textStyle="bold" android:letterSpacing="0.08"
                            android:fontFamily="sans-serif-medium" android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:padding="5dp">
                <androidx.cardview.widget.CardView android:id="@+id/cv_weight"
                    android:layout_width="match_parent" android:layout_height="140dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="22dp" app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/space_surface">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp"
                        android:background="@drawable/bg_card_glass">
                        <LinearLayout android:layout_width="56dp" android:layout_height="56dp"
                            android:background="@drawable/ic_bg_weight" android:gravity="center">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                android:src="@drawable/weight" app:tint="@color/card_weight"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" android:text="WEIGHT"
                            android:textColor="@color/space_text_primary" android:textSize="10sp"
                            android:textStyle="bold" android:letterSpacing="0.08"
                            android:fontFamily="sans-serif-medium" android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:padding="5dp">
                <androidx.cardview.widget.CardView android:id="@+id/cv_length"
                    android:layout_width="match_parent" android:layout_height="140dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="22dp" app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/space_surface">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp"
                        android:background="@drawable/bg_card_glass">
                        <LinearLayout android:layout_width="56dp" android:layout_height="56dp"
                            android:background="@drawable/ic_bg_length" android:gravity="center">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                android:src="@drawable/length" app:tint="@color/card_length"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" android:text="LENGTH"
                            android:textColor="@color/space_text_primary" android:textSize="10sp"
                            android:textStyle="bold" android:letterSpacing="0.08"
                            android:fontFamily="sans-serif-medium" android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center"
            android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingBottom="10dp"
            android:weightSum="3">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:padding="5dp">
                <androidx.cardview.widget.CardView android:id="@+id/cv_speed"
                    android:layout_width="match_parent" android:layout_height="140dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="22dp" app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/space_surface">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp"
                        android:background="@drawable/bg_card_glass">
                        <LinearLayout android:layout_width="56dp" android:layout_height="56dp"
                            android:background="@drawable/ic_bg_speed" android:gravity="center">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                android:src="@drawable/speed" app:tint="@color/card_speed"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" android:text="SPEED"
                            android:textColor="@color/space_text_primary" android:textSize="10sp"
                            android:textStyle="bold" android:letterSpacing="0.08"
                            android:fontFamily="sans-serif-medium" android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:padding="5dp">
                <androidx.cardview.widget.CardView android:id="@+id/cv_currency"
                    android:layout_width="match_parent" android:layout_height="140dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="22dp" app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/space_surface">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp"
                        android:background="@drawable/bg_card_glass">
                        <LinearLayout android:layout_width="56dp" android:layout_height="56dp"
                            android:background="@drawable/ic_bg_currency" android:gravity="center">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                android:src="@drawable/convert" app:tint="@color/card_currency"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" android:text="CURRENCY"
                            android:textColor="@color/space_text_primary" android:textSize="10sp"
                            android:textStyle="bold" android:letterSpacing="0.08"
                            android:fontFamily="sans-serif-medium" android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:padding="5dp">
                <androidx.cardview.widget.CardView android:id="@+id/cv_Volume"
                    android:layout_width="match_parent" android:layout_height="140dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="22dp" app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/space_surface">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp"
                        android:background="@drawable/bg_card_glass">
                        <LinearLayout android:layout_width="56dp" android:layout_height="56dp"
                            android:background="@drawable/ic_bg_volume" android:gravity="center">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                android:src="@drawable/volume" app:tint="@color/card_volume"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" android:text="VOLUME"
                            android:textColor="@color/space_text_primary" android:textSize="10sp"
                            android:textStyle="bold" android:letterSpacing="0.08"
                            android:fontFamily="sans-serif-medium" android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center"
            android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingBottom="10dp"
            android:weightSum="3">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:padding="5dp">
                <androidx.cardview.widget.CardView android:id="@+id/cv_time"
                    android:layout_width="match_parent" android:layout_height="140dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="22dp" app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/space_surface">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp"
                        android:background="@drawable/bg_card_glass">
                        <LinearLayout android:layout_width="56dp" android:layout_height="56dp"
                            android:background="@drawable/ic_bg_time" android:gravity="center">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                android:src="@drawable/time" app:tint="@color/card_time"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" android:text="TIME"
                            android:textColor="@color/space_text_primary" android:textSize="10sp"
                            android:textStyle="bold" android:letterSpacing="0.08"
                            android:fontFamily="sans-serif-medium" android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:padding="5dp">
                <androidx.cardview.widget.CardView android:id="@+id/cv_area"
                    android:layout_width="match_parent" android:layout_height="140dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="22dp" app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/space_surface">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp"
                        android:background="@drawable/bg_card_glass">
                        <LinearLayout android:layout_width="56dp" android:layout_height="56dp"
                            android:background="@drawable/ic_bg_area" android:gravity="center">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                android:src="@drawable/area" app:tint="@color/card_area"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" android:text="AREA"
                            android:textColor="@color/space_text_primary" android:textSize="10sp"
                            android:textStyle="bold" android:letterSpacing="0.08"
                            android:fontFamily="sans-serif-medium" android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:padding="5dp">
                <androidx.cardview.widget.CardView android:id="@+id/cv_fuel"
                    android:layout_width="match_parent" android:layout_height="140dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="22dp" app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/space_surface">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp"
                        android:background="@drawable/bg_card_glass">
                        <LinearLayout android:layout_width="56dp" android:layout_height="56dp"
                            android:background="@drawable/ic_bg_fuel" android:gravity="center">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                android:src="@drawable/fuel" app:tint="@color/card_fuel"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" android:text="FUEL"
                            android:textColor="@color/space_text_primary" android:textSize="10sp"
                            android:textStyle="bold" android:letterSpacing="0.08"
                            android:fontFamily="sans-serif-medium" android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
