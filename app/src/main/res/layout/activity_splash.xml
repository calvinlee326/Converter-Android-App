<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/space_black">

    <LinearLayout
        android:id="@+id/ll_splash_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_splash_logo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@mipmap/ic_launcher_round"
            android:scaleType="fitCenter" />

        <View
            android:id="@+id/v_splash_divider"
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:layout_marginTop="36dp"
            android:background="@color/space_border" />

        <TextView
            android:id="@+id/tv_splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.22"
            android:text="CONVERTER"
            android:textColor="@color/space_text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.08"
            android:text="PRECISION  ·  CRAFTED"
            android:textColor="@color/space_text_secondary"
            android:textSize="11sp" />

    </LinearLayout>

</RelativeLayout>
